# Copy to .env for local development. NEVER commit a real .env (it is git-ignored).
# Production values come from AWS Secrets Manager / task definition, not from files.

TIRAG_ENV=dev
TIRAG_LOG_LEVEL=INFO

# --- storage ---------------------------------------------------------------------------
# memory = zero-dependency local dev (persisted to TIRAG_MEMORY_INDEX_PATH); pgvector = prod
TIRAG_STORE_BACKEND=memory
TIRAG_MEMORY_INDEX_PATH=.data/index.json
# For pgvector (docker compose sets these for you):
# TIRAG_STORE_BACKEND=pgvector
# TIRAG_DB_HOST=localhost
# TIRAG_DB_USER=tirag
# TIRAG_DB_PASSWORD=change-me-locally
# TIRAG_DB_SSLMODE=prefer

# --- models ----------------------------------------------------------------------------
# hash/extractive need no credentials (offline dev + CI). Production uses bedrock.
TIRAG_EMBEDDING_PROVIDER=hash
TIRAG_EMBEDDING_DIM=384
TIRAG_LLM_PROVIDER=extractive
# Bedrock (uses the IAM role / AWS profile; no keys in env):
# TIRAG_EMBEDDING_PROVIDER=bedrock
# TIRAG_EMBEDDING_DIM=1024
# TIRAG_LLM_PROVIDER=bedrock
# TIRAG_AWS_REGION=us-east-1
# TIRAG_LLM_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# TIRAG_BEDROCK_GUARDRAIL_ID=

# --- auth ------------------------------------------------------------------------------
# apikey: generate with `tirag keygen --name alice --role analyst --max-tlp AMBER`
TIRAG_AUTH_MODE=disabled
# TIRAG_AUTH_MODE=apikey
# TIRAG_API_KEYS_JSON=[{"name":"alice","sha256":"<hex>","role":"analyst","max_tlp":"AMBER"}]

# --- feeds -----------------------------------------------------------------------------
# TIRAG_MISP_URL=https://misp.example.org
# TIRAG_MISP_API_KEY=
# TIRAG_MISP_TRUSTED_ORGS=MY-CSIRT,PARTNER-ISAC
# TIRAG_OPENCTI_URL=https://opencti.example.org
# TIRAG_OPENCTI_TOKEN=
